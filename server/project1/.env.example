# RentlyX Environment Configuration
# Copy this file to .env and fill in your actual values

# Django Configuration
DEBUG=False
SECRET_KEY=your-very-long-secret-key-here-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateways
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_BASE_URL=https://api.cashfree.com
CASHFREE_API_VERSION=2022-09-01

RZP_KEY_ID=your-razorpay-key-id
RZP_KEY_SECRET=your-razorpay-key-secret

# AI/ML Configuration
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=mistral

# Security
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Automatic Government Portal Verification (Optional)
# Add these to enable automatic verification against government records
# Contact your municipal corporation for API credentials
PROPERTY_REGISTRY_API_URL=https://your-municipality.com/api/registry/verify
PROPERTY_REGISTRY_API_KEY=your-registry-api-key

TAX_PAYMENT_API_URL=https://your-municipality.com/api/tax/verify
TAX_PAYMENT_API_KEY=your-tax-api-key

IDENTITY_VERIFICATION_API_URL=https://your-identity-service.gov.in/verify
IDENTITY_VERIFICATION_API_KEY=your-identity-api-key

ADMIN_EMAIL=admin@rentlyx.com